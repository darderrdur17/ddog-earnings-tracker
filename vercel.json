{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix dashboard",
  "buildCommand": "npm run build --prefix dashboard",
  "outputDirectory": "dashboard/dist",
  "rewrites": [
    { "source": "/((?!slides\\.html$).*)", "destination": "/index.html" }
  ]
}
